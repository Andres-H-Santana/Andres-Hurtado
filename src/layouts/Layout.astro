---
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio profesional' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>