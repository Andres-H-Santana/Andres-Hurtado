---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="badge">{label}</span>

<style>
  .badge {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-primary);
    background: var(--bg-sky);
    border: 0;
    border-radius: 999px;
    letter-spacing: 0.3px;
  }
</style>