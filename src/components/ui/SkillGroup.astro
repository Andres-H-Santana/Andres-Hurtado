---
import TechBadge from './TechBadge.astro';
import type { SkillGroup } from '@utils/data';

interface Props {
  group: SkillGroup;
}

const { group } = Astro.props;
---

<div class="skillGroup glass-effect">
  <h4 class="skillCategory">{group.category}</h4>
  <div class="skillItems">
    {group.items.map((skill) => (
      <TechBadge label={skill} />
    ))}
  </div>
</div>

<style>
  .skillGroup {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .skillCategory {
    font-size: 0.95rem;
    font-weight: 600;
    color: #7dd3fc;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .skillItems {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>