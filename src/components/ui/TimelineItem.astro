---
interface Props {
  title: string;
  subtitle: string;
  period: string;
  description?: string;
  card?: boolean;
}

const { title, subtitle, period, description, card = false } = Astro.props;
---

<div class:list={['timelineItem', { 'timelineItem--card': card }]}>
  <div class="timelineDot" />
  <div class="timelineContent">
    <span class="period">{period}</span>
    <h4 class="title">{title}</h4>
    <p class="subtitle">{subtitle}</p>
    {description && <p class="description">{description}</p>}
  </div>
</div>

<style>
  .timelineItem {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 1.5rem;
  }

  /* La línea vertical */
  .timelineItem::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 0;
    width: 2px;
    background: var(--bg-sky);
  }

  .timelineItem:last-child::before {
    display: none;
  }

  .timelineDot {
    position: absolute;
    left: 0;
    top: 8px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-warm);
  }

  .timelineContent {
    padding: 1.25rem 1.5rem;
  }

  .timelineItem--card {
    padding: 0;
  }

  .timelineItem--card::before,
  .timelineItem--card .timelineDot {
    display: none;
  }

  .timelineItem--card .timelineContent {
    padding: 1.35rem 1.5rem;
    border: 0;
    border-radius: 1rem;
    background: var(--glass-surface);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .timelineItem--card:hover .timelineContent {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(116, 89, 68, 0.11);
  }

  .period {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: var(--bg-soft);
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }

  .description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 0.75rem;
  }

  @media (max-width: 640px) {
    .timelineContent {
      padding: 1rem 0.75rem;
    }

    .timelineItem--card .timelineContent {
      padding: 1.1rem;
    }
  }
</style>