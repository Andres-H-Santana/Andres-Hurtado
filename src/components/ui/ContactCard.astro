---
import { Icon } from 'astro-icon/components';
import type { ContactLink } from '@utils/data';

interface Props {
  contact: ContactLink;
}

const { contact } = Astro.props;
---

<a
  href={contact.href}
  target={contact.href.startsWith('mailto:') ? '_self' : '_blank'}
  rel="noopener noreferrer"
  class="contactCard"
>
  <Icon name={contact.icon} class="contactIcon" />
  <div class="contactInfo">
    <span class="contactLabel">{contact.label}</span>
    <span class="contactValue">{contact.value}</span>
  </div>
</a>

<style>
  .contactCard {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.35rem 0;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contactCard:hover .contactValue {
    color: var(--bg-warm);
  }

  .contactIcon {
    width: 26px;
    height: 26px;
    color: var(--bg-warm);
    flex-shrink: 0;
  }

  .contactInfo {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    overflow: hidden;
  }

  .contactLabel {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--bg-warm);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .contactValue {
    font-size: 0.88rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>