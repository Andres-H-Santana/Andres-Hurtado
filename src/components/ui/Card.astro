---
import TechBadge from './TechBadge.astro';
import type { Project } from '@utils/data';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card glass-effect">
  {project.image && (
    <div class="card__media">
      <img
        src={project.image.src}
        alt={project.altText ?? project.name}
        width={project.image.width}
        height={project.image.height}
        class="card__image"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <header class="card__header">
    <h3 class="card__title">{project.name}</h3>
  </header>

  <p class="card__description">{project.description}</p>

  <div class="card__meta">
    {project.technologies.map((tech) => (
      <TechBadge label={tech} />
    ))}
  </div>

  <footer class="card__footer">
    <a
      href={project.link}
      target="_blank"
      rel="noopener noreferrer"
      class="card__action nav-button"
    >
      Ver proyecto
    </a>
  </footer>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem;
    height: 100%;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 38px rgba(116, 89, 68, 0.14);
  }

  /* Slot 1: Media — sangra hasta los bordes redondeados */
  .card__media {
    margin: -1.4rem -1.4rem 0;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background: var(--bg-sky);
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .card:hover .card__image {
    transform: scale(1.05);
  }

  /* Slot 2: Header */
  .card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .card__title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  /* Slot 3: Descripción */
  .card__description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    text-align: justify;
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
  }

  /* Slot 4: Tecnologías */
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Slot 5: Footer — empuja al fondo de la columna flex */
  .card__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--bg-soft);
  }

  .card__action {
    align-self: flex-start;
  }

  @media (max-width: 640px) {
    .card {
      gap: 0.75rem;
      padding: 1.1rem;
    }

    .card__media {
      margin: -1.1rem -1.1rem 0;
    }
  }
</style>