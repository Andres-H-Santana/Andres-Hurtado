---
import TechBadge from './TechBadge.astro';
import type { Project } from '@utils/data';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card">
  {project.image && (
    <div class="card__media">
      <img
        src={project.image.src}
        alt={project.altText ?? project.name}
        width={project.image.width}
        height={project.image.height}
        class="card__image"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <header class="card__header">
    <h3 class="card__title">{project.name}</h3>
  </header>

  <p class="card__description">{project.description}</p>

  <div class="card__meta">
    {project.technologies.map((tech) => (
      <TechBadge label={tech} />
    ))}
  </div>

  <footer class="card__footer">
    <a
      href={project.link}
      target="_blank"
      rel="noopener noreferrer"
      class="card__action card__action--primary"
    >
      Ver proyecto
    </a>
  </footer>
</article>

<style>
  .card {
    /* ─── Glassmorfismo ─── */
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);

    /* Layout */
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    height: 100%;
    overflow: hidden;

    transition: transform 0.3s ease, box-shadow 0.3s ease,
      border-color 0.3s ease, background 0.3s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(125, 211, 252, 0.35);
    box-shadow: 0 16px 48px rgba(125, 211, 252, 0.18);
  }

  /* Slot 1: Media — sangra hasta los bordes redondeados */
  .card__media {
    margin: -1.75rem -1.75rem 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgba(30, 41, 59, 0.5);
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .card:hover .card__image {
    transform: scale(1.05);
  }

  /* Slot 2: Header */
  .card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .card__title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #f8fafc;
    margin: 0;
    line-height: 1.3;
  }

  /* Slot 3: Descripción */
  .card__description {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* Slot 4: Tecnologías */
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Slot 5: Footer — empuja al fondo de la columna flex */
  .card__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card__action {
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 10.5rem;
    padding: 0.5rem 0.9rem;
    transition: background 0.2s ease, color 0.2s ease,
      box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card__action--primary {
    background: rgba(125, 211, 252, 0.15);
    color: #7dd3fc;
    border: 1px solid rgba(125, 211, 252, 0.35);
  }

  .card__action--primary:hover {
    background: rgba(125, 211, 252, 0.25);
    box-shadow: 0 0 18px rgba(125, 211, 252, 0.3);
    transform: translateY(-1px);
  }

  .card__action--ghost {
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }

  .card__action--ghost:hover {
    color: #f8fafc;
    border-color: rgba(148, 163, 184, 0.6);
  }
</style>