---
import TechBadge from './TechBadge.astro';
import type { Project } from '@utils/data';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card glass-effect">
  <header class="cardHeader">
    <h3 class="cardTitle">{project.name}</h3>
    <a
      href={project.link}
      target="_blank"
      rel="noopener noreferrer"
      class="cardLink"
      aria-label={`Ver ${project.name}`}
    >
      Ver proyecto
    </a>
  </header>

  <p class="cardDescription">{project.description}</p>

  <footer class="cardTechs">
    {project.technologies.map((tech) => (
      <TechBadge label={tech} />
    ))}
  </footer>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(125, 211, 252, 0.15);
    border-color: rgba(125, 211, 252, 0.3);
  }

  .cardHeader {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .cardTitle {
    font-size: 1.15rem;
    font-weight: 600;
    color: #f8fafc;
    margin: 0;
  }

  .cardLink {
    font-size: 0.8rem;
    color: #7dd3fc;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .cardLink:hover {
    opacity: 0.7;
  }

  .cardDescription {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.6;
    flex-grow: 1;
  }

  .cardTechs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
</style>