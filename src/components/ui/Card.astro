---
import { Icon } from 'astro-icon/components';
import TechBadge from './TechBadge.astro';
import { personalInfo, type Project } from '@utils/data';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card" data-scroll-reveal>
  {project.image ? (
    <img
      src={project.image.src}
      alt={project.altText ?? `Vista previa de ${project.name}`}
      width={project.image.width}
      height={project.image.height}
      class="project-image"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="project-image project-image--fallback" aria-hidden="true">{project.name}</div>
  )}

  <div class="image-shade"></div>

  <div class="project-panel">
    <div class="panel-handle"></div>
    <div class="project-meta">
      <span>Desarrollo web</span>
    </div>

    <h3 class="project-title">{project.name}</h3>

    <div class="project-details">
      <p>{project.description}</p>
      <div class="project-techs">
        {project.technologies.map((tech) => (
          <TechBadge label={tech} />
        ))}
      </div>

      <div class="project-actions">
        <a
          class="icon-button"
          href={project.github ?? personalInfo.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={project.github ? `Ver el código de ${project.name} en GitHub` : 'Abrir perfil de GitHub'}
          title="GitHub"
        >
          <Icon name="simple-icons:github" class="github-icon" aria-hidden="true" />
        </a>

        <a class="more-button" href={project.link} target="_blank" rel="noopener noreferrer">
          <span class="button-label">Ver más</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    height: 31rem;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 1.5rem;
    background: var(--glass-surface);
    box-shadow: var(--glass-shadow);
    isolation: isolate;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 58px rgba(0, 0, 0, 0.38), inset 0 1px 0 var(--glass-highlight);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.03);
    transition: transform 700ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .project-image--fallback {
    display: grid;
    place-items: center;
    padding: 2rem;
    background: linear-gradient(135deg, var(--bg-soft), var(--bg-sky));
    color: var(--text-primary);
    font-size: 1.35rem;
    font-weight: 700;
    text-align: center;
  }

  .image-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(2, 9, 6, 0.02) 30%, rgba(2, 8, 6, 0.35) 70%);
    pointer-events: none;
  }

  .project-panel {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 1.2rem 1.35rem 1.35rem;
    border-top: 1px solid var(--glass-border);
    background: var(--glass-surface);
    box-shadow: 0 -1rem 2.75rem rgba(0, 0, 0, 0.24);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    /* Sin transición de altura — el layout se mantiene estable */
  }

  .panel-handle {
    width: 38px;
    height: 3px;
    margin: -0.45rem auto 1rem;
    border-radius: 99px;
    background: var(--glass-border);
  }

  .project-meta {
    display: flex;
    color: var(--text-secondary);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project-title {
    margin: 7px 0 0;
    font-family: 'Manrope', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--text-primary);
  }

  /* El detalle se oculta con una fila de grid 0fr -> 1fr.
     Esto mantiene el flujo ordenado y no rompe el layout. */
  .project-details {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 380ms cubic-bezier(0.2, 0.75, 0.2, 1),
      opacity 240ms ease;
  }

  .project-details > * {
    overflow: hidden;
    min-height: 0;
  }

  .project-details p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .project-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
  }

  .project-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-bottom: 0.1rem;
  }

  .icon-button,
  .more-button {
    display: inline-flex;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .icon-button {
    width: 44px;
    flex: 0 0 44px;
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .more-button {
    flex: 1;
    padding: 0 1rem;
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .icon-button :global(.github-icon) {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .button-label {
    width: 100%;
    text-align: center;
  }

  .icon-button:hover,
  .more-button:hover {
    transform: translateY(-2px);
    background: var(--glass-button-hover);
  }

  .icon-button:focus-visible,
  .more-button:focus-visible {
    outline: 2px solid var(--bg-warm);
    outline-offset: 3px;
  }

  /* Interacción solo en dispositivos con hover real */
  @media (hover: hover) {
    .project-card:hover .project-details,
    .project-card:focus-within .project-details {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .project-card:hover .project-image,
    .project-card:focus-within .project-image {
      transform: translateY(-5%) scale(1.1);
    }
  }

  /* En móvil el detalle queda siempre visible y ordenado */
  @media (max-width: 520px) {
    .project-card {
      height: 28rem;
      border-radius: 1.3rem;
    }

    .project-details {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-image,
    .project-panel,
    .project-details,
    .icon-button,
    .more-button {
      transition-duration: 0.01ms;
    }
  }
</style>