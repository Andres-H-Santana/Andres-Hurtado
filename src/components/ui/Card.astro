---
import TechBadge from './TechBadge.astro';
import type { Project } from '@utils/data';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card" data-scroll-reveal>
  {project.image ? (
    <div class="card__media">
      <img
        src={project.image.src}
        alt={project.altText ?? `Vista previa de ${project.name}`}
        width={project.image.width}
        height={project.image.height}
        class="card__image"
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class="card__media card__media--fallback" aria-hidden="true">
      <span>{project.name}</span>
    </div>
  )}

  <div class="card__content">
    <header class="card__header">
      <span class="card__eyebrow">Proyecto destacado</span>
      <h3 class="card__title">{project.name}</h3>
    </header>

    <p class="card__description">{project.description}</p>

    <div class="card__meta" aria-label="Tecnologías utilizadas">
      {project.technologies.map((tech) => (
        <TechBadge label={tech} />
      ))}
    </div>

    <footer class="card__footer">
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="card__action nav-button"
      >
        Ver más
      </a>
    </footer>
  </div>
</article>

<style>
  .card {
    display: flex;
    min-width: 0;
    min-height: 33rem;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.5rem;
    background: var(--glass-surface);
    box-shadow: var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    transition: transform 240ms ease, box-shadow 240ms ease;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 58px rgba(0, 0, 0, 0.38), inset 0 1px 0 var(--glass-highlight);
  }

  .card__media {
    flex: 0 0 12rem;
    overflow: hidden;
    background: var(--bg-soft);
  }

  .card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .card:hover .card__image {
    transform: scale(1.045);
  }

  .card__media--fallback {
    display: grid;
    place-items: center;
    padding: 2rem;
    background: linear-gradient(135deg, var(--bg-soft), var(--bg-sky));
    color: var(--text-primary);
    font-size: 1.4rem;
    font-weight: 700;
    text-align: center;
  }

  .card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: 1.4rem;
  }

  .card__eyebrow {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--card-eyebrow);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card__title {
    margin: 0;
    color: var(--card-text);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .card__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--card-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .card__footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.15rem;
  }

  .card__action {
    min-width: 7rem;
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    background: rgba(255, 255, 255, 0.08);
    color: var(--card-text);
    font-weight: 650;
    box-shadow: none;
  }

  .card__action:hover {
    background: var(--glass-button-hover);
  }

  @media (max-width: 640px) {
    .card {
      min-height: 30rem;
    }

    .card__media {
      flex-basis: 11rem;
    }

    .card__content {
      gap: 0.85rem;
      padding: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__image {
      transition: none;
    }
  }
</style>
