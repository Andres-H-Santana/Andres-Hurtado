---
import TechBadge from './TechBadge.astro';
import type { Project } from '@utils/data';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card" data-scroll-reveal>
  {project.image ? (
    <div class="card__media">
      <img
        src={project.image.src}
        alt={project.altText ?? `Vista previa de ${project.name}`}
        width={project.image.width}
        height={project.image.height}
        class="card__image"
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class="card__media card__media--fallback" aria-hidden="true">
      <span>{project.name}</span>
    </div>
  )}

  <div class="card__content">
    <header class="card__header">
      <span class="card__eyebrow">Proyecto destacado</span>
      <h3 class="card__title">{project.name}</h3>
    </header>

    <p class="card__description">{project.description}</p>

    <div class="card__meta" aria-label="Tecnologías utilizadas">
      {project.technologies.map((tech) => (
        <TechBadge label={tech} />
      ))}
    </div>

    <footer class="card__footer">
      {project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="card__github nav-button"
          aria-label={`Ver el código de ${project.name} en GitHub`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .321.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            />
          </svg>
        </a>
      )}
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="card__action nav-button"
      >
        Ver más
      </a>
    </footer>
  </div>
</article>

<style>
  .card {
    display: flex;
    min-width: 0;
    min-height: 33rem;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.5rem;
    background: var(--glass-surface);
    box-shadow: var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    transition: transform 240ms ease, box-shadow 240ms ease;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 58px rgba(0, 0, 0, 0.38), inset 0 1px 0 var(--glass-highlight);
  }

  .card__media {
    flex: 0 0 12rem;
    overflow: hidden;
    background: var(--bg-soft);
  }

  .card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .card:hover .card__image {
    transform: scale(1.045);
  }

  .card__media--fallback {
    display: grid;
    place-items: center;
    padding: 2rem;
    background: linear-gradient(135deg, var(--bg-soft), var(--bg-sky));
    color: var(--text-primary);
    font-size: 1.4rem;
    font-weight: 700;
    text-align: center;
  }

  .card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: 1.4rem;
  }

  .card__eyebrow {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--card-eyebrow);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card__title {
    margin: 0;
    color: var(--card-text);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .card__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--card-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .card__footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.15rem;
  }

  .card__github {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: rgba(255, 255, 255, 0.08);
    color: var(--card-text);
  }

  .card__github svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .card__github:hover {
    background: var(--glass-button-hover);
  }

  .card__action {
    min-width: 7rem;
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    background: rgba(255, 255, 255, 0.08);
    color: var(--card-text);
    font-weight: 650;
    box-shadow: none;
  }

  .card__action:hover {
    background: var(--glass-button-hover);
  }

  @media (max-width: 640px) {
    .card {
      min-height: 30rem;
    }

    .card__media {
      flex-basis: 11rem;
    }

    .card__content {
      gap: 0.85rem;
      padding: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__image {
      transition: none;
    }
  }
</style>