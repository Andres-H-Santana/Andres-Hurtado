---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="chip">
  <svg
    class="chipMark"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M4 8.5l2.5 2.5L12 5.5" />
  </svg>
  <span class="chipLabel">{label}</span>
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .chipMark {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    padding: 0.18rem;
    box-sizing: border-box;
    border-radius: 50%;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    opacity: 0.85;
  }

  .chipLabel {
    line-height: 1.3;
  }
</style>