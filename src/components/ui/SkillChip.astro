---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="chip">
  <span class="chipMark" aria-hidden="true">✓</span>
  {label}
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .chipMark {
    display: inline-grid;
    place-items: center;
    width: 0.95rem;
    height: 0.95rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--bg-warm);
    color: white;
    font-size: 0.62rem;
    font-weight: 700;
  }
</style>