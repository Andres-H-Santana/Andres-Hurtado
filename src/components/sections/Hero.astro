---
import { personalInfo } from '@utils/data';
import perfilImg from '@assets/images/perfil.png';
---

<section id="hero" class="hero">
  <div class="heroContent">
    <div class="heroMedia">
      <img
        src={perfilImg.src}
        alt={`Foto de ${personalInfo.name}`}
        class="profilePhoto"
        width="300"
        height="300"
      />
    </div>

    <div class="heroInfo">
      <h1 class="name">{personalInfo.name}</h1>
      <p class="role">{personalInfo.role}</p>
      <p class="description">{personalInfo.summary}</p>
      <p class="aboutText">{personalInfo.about}</p>

      <div class="actions">
        <a href="#projects" class="nav-button">Ver proyectos</a>
        <a href={personalInfo.cvLink} download class="nav-button">Descargar CV</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .heroContent {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem 0;
    max-width: 1100px;
    width: 100%;
  }

  .heroMedia {
    flex-shrink: 0;
  }

  .profilePhoto {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg-sky);
    display: block;
  }

  .heroInfo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    text-align: left;
    max-width: 560px;
  }

  .name {
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    line-height: 1.15;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .role {
    color: var(--bg-warm);
    font-weight: 700;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .description {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0.5rem 0 0;
    text-align: justify;
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
  }

  .aboutText {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.8;
    margin-top: 0.5rem;
    text-align: justify;
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 640px) {
    .heroContent {
      flex-direction: column;
      text-align: center;
      padding: 2rem 0;
      gap: 1.5rem;
      justify-content: center;
    }

    .heroInfo {
      align-items: center;
      text-align: center;
      max-width: 100%;
    }

    .profilePhoto {
      width: 140px;
      height: 140px;
    }

    .name {
      font-size: 1.6rem;
    }

    .actions {
      justify-content: center;
    }
  }
</style>