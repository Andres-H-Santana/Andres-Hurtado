---
import { personalInfo } from '@utils/data';
import perfilImg from '@assets/images/perfil.png';
---

<section id="hero" class="hero">
  <div class="heroContent glass-effect">
    <img
      src={perfilImg.src}
      alt={`Foto de ${personalInfo.name}`}
      class="profilePhoto"
      width="160"
      height="160"
    />

    <h1 class="name">{personalInfo.name}</h1>
    <p class="role">{personalInfo.role}</p>
    <p class="description">{personalInfo.description}</p>

    <a href={personalInfo.cvLink} download class="cvButton">
      Descargar CV
    </a>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .heroContent {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 3rem 2.5rem;
    max-width: 520px;
    width: 100%;
  }

  .profilePhoto {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 0 40px rgba(120, 180, 255, 0.25);
  }

  .name {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 0.5rem;
  }

  .role {
    color: #7dd3fc;
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .description {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .cvButton {
    margin-top: 1rem;
    padding: 0.75rem 1.8rem;
    border-radius: 999px;
    background: rgba(125, 211, 252, 0.15);
    border: 1px solid rgba(125, 211, 252, 0.4);
    color: #7dd3fc;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s ease;
  }

  .cvButton:hover {
    background: rgba(125, 211, 252, 0.25);
    box-shadow: 0 0 20px rgba(125, 211, 252, 0.3);
    transform: translateY(-2px);
  }
</style>