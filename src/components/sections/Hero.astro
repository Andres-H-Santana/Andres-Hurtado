---
import { personalInfo } from '@utils/data';
import perfilImg from '@assets/images/perfil.png';
---

<section id="hero" class="hero">
  <div class="heroContent glass-effect">
    <!-- Columna izquierda: foto -->
    <div class="heroMedia">
      <img
        src={perfilImg.src}
        alt={`Foto de ${personalInfo.name}`}
        class="profilePhoto"
        width="250"
        height="250"
      />
    </div>

    <!-- Columna derecha: info -->
    <div class="heroInfo">
      <h1 class="name">{personalInfo.name}</h1>
      <p class="role">{personalInfo.role}</p>
      <p class="description">{personalInfo.description}</p>

      <div class="actions">
        <a href="#contact" class="button button--primary">Contactame</a>
        <a href={personalInfo.cvLink} download class="button button--ghost">
          Descargar CV
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .heroContent {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;   /* ← foto ↔ info a extremos */
    gap: 0;
    padding: 2.5rem 3rem;
    max-width: 1100px;                 /* ← un pelín más ancho para que respire */
    width: 100%;
  }

  /* Columna izquierda */
  .heroMedia {
    flex-shrink: 0;
  }

  .profilePhoto {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 0 40px rgba(120, 180, 255, 0.25);
    display: block;
  }

  /* Columna derecha */
  .heroInfo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    text-align: left;
    max-width: 500px;                 /* ← evita que el texto se estire demasiado */
  }

  .name {
    font-size: 2rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0;
  }

  .role {
    color: #7dd3fc;
    font-weight: 500;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .description {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0.5rem 0 0;
  }

  /* Botones en fila */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .button {
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid transparent;
    display: inline-block;
  }

  .button--primary {
    background: rgba(125, 211, 252, 0.15);
    border-color: rgba(125, 211, 252, 0.4);
    color: #7dd3fc;
  }

  .button--primary:hover {
    background: rgba(125, 211, 252, 0.25);
    box-shadow: 0 0 20px rgba(125, 211, 252, 0.3);
    transform: translateY(-2px);
  }

  .button--ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.15);
    color: #94a3b8;
  }

  .button--ghost:hover {
    color: #f8fafc;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }

  /* Responsive: en móvil se apila de nuevo */
  @media (max-width: 640px) {
    .heroContent {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
      gap: 1.5rem;
      justify-content: center;
    }

    .heroInfo {
      align-items: center;
      text-align: center;
      max-width: 100%;
    }

    .profilePhoto {
      width: 140px;
      height: 140px;
    }

    .name {
      font-size: 1.6rem;
    }

    .actions {
      justify-content: center;
    }
  }
</style>