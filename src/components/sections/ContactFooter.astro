---
import ContactCard from '@components/ui/ContactCard.astro';
import { contactData, personalInfo } from '@utils/data';

const year = new Date().getFullYear();
---

<footer id="contact" class="contactFooter" data-scroll-reveal>
  <div class="footerInner">
    <div class="footerIntro">
      <h2 class="footerTitle">¿Hablamos?</h2>
      <p class="footerText">Si te interesa mi perfil, escríbeme.</p>
    </div>

    <div class="contactRow">
      {contactData.map((contact) => (
        <ContactCard contact={contact} />
      ))}
    </div>
  </div>

  <p class="footerCopy">© {year} {personalInfo.name}</p>
</footer>

<style>
  .contactFooter {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem 2rem;
    border-top: 1px solid var(--bg-soft);
    scroll-margin-top: 2rem;
  }

  .footerInner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footerTitle {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .footerText {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .contactRow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .footerCopy {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-secondary);
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .contactFooter {
      padding: 2.5rem 1.25rem 1.5rem;
    }
  }
</style>    