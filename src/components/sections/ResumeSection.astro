---
import TimelineItem from '@components/ui/TimelineItem.astro';
import SkillChip from '@components/ui/SkillChip.astro';
import TechKeyboard from '@components/ui/TechKeyboard';
import { getKeyIcons } from '@utils/iconData';
import ContactCard from '@components/ui/ContactCard.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import {
  experienceData,
  softSkillsData,
  toolsData,
  languagesData,
  technologiesData,
  educationData,
  contactData,
} from '@utils/data';

const keyIcons = getKeyIcons(technologiesData);

const languageProgress: Record<string, number> = {
  A1: 20,
  A2: 35,
  B1: 50,
  B2: 65,
  C1: 80,
  C2: 100,
};
---

<section id="resume" class="resumeSection" data-scroll-reveal>
  <SectionHeader title="Currículum" subtitle="Experiencia, habilidades y formación." />

  <div class="cvLayout">
    <div class="mainColumn">
    <div class="block" data-scroll-reveal>
      <h3 class="blockTitle">Experiencia</h3>
      <div class="timeline">
        {experienceData.map((exp) => (
          <TimelineItem
            card
            title={exp.role}
            subtitle={exp.company}
            period={exp.period}
            description={exp.description}
          />
        ))}
      </div>
    </div>

    <div class="block" data-scroll-reveal>
      <h3 class="blockTitle">Habilidades</h3>

      <h4 class="subBlockTitle">Blandas</h4>
      <div class="chipsGrid">
        {softSkillsData.map((skill) => (
          <SkillChip label={skill.label} />
        ))}
      </div>

      <h4 class="subBlockTitle">Herramientas</h4>
      <div class="chipsGrid">
        {toolsData.map((tool) => (
          <SkillChip label={tool.label} />
        ))}
      </div>
    </div>

    <div class="block" data-scroll-reveal>
      <h3 class="blockTitle">Tecnologías</h3>
      <TechKeyboard client:visible keys={keyIcons} />
    </div>
  </div>

    <aside class="sideColumn">
      <div class="block" id="contact" data-scroll-reveal>
        <h3 class="blockTitle">Contacto</h3>
        <div class="contactGrid">
          {contactData.map((contact) => (
            <ContactCard contact={contact} />
          ))}
        </div>
      </div>

      <div class="block" data-scroll-reveal>
        <h3 class="blockTitle">Estudios</h3>
        <div class="timeline">
          {educationData.map((edu) => (
            <TimelineItem
              card
              title={edu.title}
              subtitle={edu.institution}
              period={edu.period}
            />
          ))}
        </div>
      </div>

      <div class="block" data-scroll-reveal>
        <h3 class="blockTitle">Idiomas</h3>
        <div class="languageList">
          {languagesData.map((language) => (
            <div class="languageItem">
              <div class="languageInfo">
                <span class="languageName">{language.name}</span>
                <span class="languageLevel">{language.level}</span>
              </div>
              <div
                class="languageProgress"
                role="meter"
                aria-label={`${language.name}: nivel ${language.level}`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow={languageProgress[language.level] ?? 0}
              >
                <span
                  class="languageProgressFill"
                  style={`--progress: ${languageProgress[language.level] ?? 0}%`}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .resumeSection {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    scroll-margin-top: 2rem;
  }

  .cvLayout {
    display: grid;
    grid-template-columns: minmax(0, 68fr) minmax(250px, 32fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .mainColumn,
  .sideColumn {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .block {
    margin-bottom: 0;
  }

  .sideColumn .block + .block {
    padding-top: 1.5rem;
    border-top: 1px solid var(--bg-soft);
  }

  .blockTitle {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .subBlockTitle {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bg-warm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 1.25rem 0 0.85rem;
  }

  .chipsGrid {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contactGrid {
    display: grid;
    gap: 0.5rem;
  }

  .languageList {
    display: grid;
    gap: 1rem;
  }

  .languageItem {
    display: grid;
    gap: 0.45rem;
  }

  .languageInfo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 0.75rem;
  }

  .languageName {
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .languageLevel {
    color: var(--bg-warm);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .languageProgress {
    height: 0.55rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--bg-soft);
  }

  .languageProgressFill {
    display: block;
    width: var(--progress);
    height: 100%;
    border-radius: inherit;
    background: var(--bg-warm);
  }

  .cta {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  @media (max-width: 900px) {
    .cvLayout {
      grid-template-columns: minmax(0, 1.6fr) minmax(220px, 1fr);
    }
  }

  @media (max-width: 720px) {
    .cvLayout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sideColumn {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
      gap: 1.5rem;
    }

    .sideColumn .block + .block {
      padding-top: 0;
      border-top: 0;
    }
  }

  @media (max-width: 640px) {
    .resumeSection {
      padding: 3rem 1.25rem 4rem;
    }
  }
</style>