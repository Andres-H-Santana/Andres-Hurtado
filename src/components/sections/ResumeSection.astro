---
import TimelineItem from '@components/ui/TimelineItem.astro';
import SkillChip from '@components/ui/SkillChip.astro';
import { getKeyIcons } from '@utils/iconData';
import SectionHeader from '@components/ui/SectionHeader.astro';
import {
  experienceData,
  softSkillsData,
  toolsData,
  languagesData,
  technologiesData,
  educationData,
} from '@utils/data';

const keyIcons = getKeyIcons(technologiesData);

const languageProgress: Record<string, number> = {
  A1: 20,
  A2: 35,
  B1: 50,
  B2: 65,
  C1: 80,
  C2: 100,
};
---

<section id="resume" class="resumeSection" data-scroll-reveal>
  <SectionHeader
    title="Quién soy"
    subtitle="Un vistazo a mi experiencia, habilidades y formación."
  />

  <div class="cvLayout">
    <div class="mainColumn">
      <div class="block" data-scroll-reveal>
        <h3 class="blockTitle">Experiencia</h3>
        <div class="timeline">
          {experienceData.map((exp) => (
            <TimelineItem
              card
              title={exp.role}
              subtitle={exp.company}
              period={exp.period}
              description={exp.description}
            />
          ))}
        </div>
      </div>

      <div class="block" data-scroll-reveal>
        <h3 class="blockTitle">Habilidades</h3>

        <div class="skillsRow">
          <div class="skillsGroup">
            <h4 class="subBlockTitle">Blandas</h4>
            <div class="chipsGrid">
              {softSkillsData.map((skill) => (
                <SkillChip label={skill.label} />
              ))}
            </div>
          </div>

          <div class="skillsGroup">
            <h4 class="subBlockTitle">Herramientas</h4>
            <div class="chipsGrid">
              {toolsData.map((tool) => (
                <SkillChip label={tool.label} />
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="block" data-scroll-reveal>
        <h3 class="blockTitle">Tecnologías</h3>
        <ul class="techGrid" aria-label="Tecnologías">
          {keyIcons.map((key) => (
            <li class="techGrid__cell">
              <div class="techGrid__item" role="img" aria-label={key.name} tabindex="0">
                <svg
                  class="techGrid__icon"
                  viewBox={`0 0 ${key.width} ${key.height}`}
                  aria-hidden="true"
                  focusable="false"
                  set:html={key.body}
                />
                <span class="techGrid__tooltip" aria-hidden="true">{key.name}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="sideColumn">
      <div class="block" data-scroll-reveal>
        <h3 class="blockTitle">Sobre mí</h3>
        <div class="aboutText">
          <p>Hola. Soy un desarrollador apasionado por la tecnología y la constante innovación. Me defino como una persona proactiva, analítica y muy curiosa; siempre estoy intrigado por lo nuevo y buscando activamente cómo aplicarlo en mis desarrollos.</p>
          <p>Fuera del código, soy una persona muy activa: disfruto del deporte, la danza y perderme en la belleza de los paisajes. En el frontend, tengo claros mis principios: me encanta el minimalismo y el glassmorphism, pero siempre estoy dispuesto a explorar nuevas tendencias. Al final, este sector nos obliga a mantenernos en constante actualización, y eso es justo lo que más me gusta.</p>
        </div>
      </div>

      <div class="block" data-scroll-reveal>
        <h3 class="blockTitle">Estudios</h3>
        <div class="timeline">
          {educationData.map((edu) => (
            <TimelineItem
              card
              title={edu.title}
              subtitle={edu.institution}
              period={edu.period}
            />
          ))}
        </div>
      </div>

      <div class="block" data-scroll-reveal>
        <h3 class="blockTitle">Idiomas</h3>
        <div class="languageList">
          {languagesData.map((language) => (
            <div class="languageItem">
              <div class="languageInfo">
                <span class="languageName">{language.name}</span>
                <span class="languageLevel">{language.level}</span>
              </div>
              <div
                class="languageProgress"
                role="meter"
                aria-label={`${language.name}: nivel ${language.level}`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow={languageProgress[language.level] ?? 0}
              >
                <span
                  class="languageProgressFill"
                  style={`--progress: ${languageProgress[language.level] ?? 0}%`}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .resumeSection {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    scroll-margin-top: 2rem;
  }

  .cvLayout {
    display: grid;
    grid-template-columns: minmax(0, 64fr) minmax(250px, 36fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .mainColumn,
  .sideColumn {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sideColumn .block + .block {
    padding-top: 1.5rem;
    border-top: 1px solid var(--bg-soft);
  }

  .blockTitle {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .aboutText {
    display: grid;
    gap: 0.9rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .subBlockTitle {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bg-warm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.85rem;
  }

  /* Blandas y Herramientas, una al lado de la otra */
  .skillsRow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }

  .chipsGrid {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .techGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .techGrid__cell {
    min-width: 0;
  }

  .techGrid__item {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 4.5rem;
    place-items: center;
    border: 1px solid var(--glass-border);
    border-radius: 1rem;
    background: var(--glass-surface);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 8px 22px rgba(0, 0, 0, 0.14);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    color: var(--text-primary);
    cursor: help;
    outline: none;
    transition: transform 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }

  .techGrid__item:hover,
  .techGrid__item:focus-visible {
    z-index: 2;
    transform: translateY(-3px);
    background: rgba(80, 103, 145, 0.36);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 12px 28px rgba(0, 0, 0, 0.24);
  }

  .techGrid__item:focus-visible {
    outline: 2px solid var(--bg-warm);
    outline-offset: 3px;
  }

  .techGrid__icon {
    display: block;
    width: 1.8rem;
    height: 1.8rem;
    fill: currentColor;
  }

  .techGrid__tooltip {
    position: absolute;
    z-index: 3;
    bottom: calc(100% + 0.55rem);
    left: 50%;
    width: max-content;
    max-width: min(14rem, 80vw);
    padding: 0.45rem 0.7rem;
    transform: translate(-50%, 4px);
    border: 1px solid var(--glass-border);
    border-radius: 0.65rem;
    background: rgba(20, 28, 48, 0.94);
    box-shadow: var(--glass-shadow);
    color: var(--text-primary);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .techGrid__item:hover .techGrid__tooltip,
  .techGrid__item:focus-visible .techGrid__tooltip {
    transform: translate(-50%, 0);
    opacity: 1;
  }

  .languageList {
    display: grid;
    gap: 1rem;
  }

  .languageItem {
    display: grid;
    gap: 0.45rem;
  }

  .languageInfo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 0.75rem;
  }

  .languageName {
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .languageLevel {
    color: var(--bg-warm);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .languageProgress {
    height: 0.55rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--bg-soft);
  }

  .languageProgressFill {
    display: block;
    width: var(--progress);
    height: 100%;
    border-radius: inherit;
    background: var(--bg-warm);
  }

  @media (max-width: 900px) {
    .cvLayout {
      grid-template-columns: minmax(0, 1.6fr) minmax(220px, 1fr);
    }
  }

  @media (max-width: 720px) {
    .cvLayout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sideColumn {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
      gap: 1.5rem;
    }

    .sideColumn .block + .block {
      padding-top: 0;
      border-top: 0;
    }
  }

  @media (max-width: 640px) {
    .resumeSection {
      padding: 3rem 1.25rem 4rem;
    }

    .techGrid {
      grid-template-columns: repeat(auto-fill, minmax(3.75rem, 1fr));
      gap: 0.65rem;
    }

    .techGrid__item {
      min-height: 3.75rem;
    }
  }

  /* En pantallas muy angostas las dos columnas de habilidades se apilan */
  @media (max-width: 380px) {
    .skillsRow {
      grid-template-columns: 1fr;
    }
  }
</style>